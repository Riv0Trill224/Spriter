<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <application android:label="Spriter" android:theme="@style/AppTheme"
        android:icon="@drawable/ic_spriter" android:allowBackup="false" android:fullBackupContent="false" android:dataExtractionRules="@xml/data_extraction_rules" android:usesCleartextTraffic="false"
        android:supportsRtl="true" android:resizeableActivity="true">
        <activity android:name=".MainActivity" android:exported="true" android:theme="@style/StageTheme"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".StageActivity" android:exported="false"
            android:taskAffinity="com.riv0trill.spriter.stage"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density"
            android:theme="@style/StageTheme" />
        <provider android:name=".ApkProvider" android:authorities="com.riv0trill.spriter.updates"
            android:exported="false" android:grantUriPermissions="true" />
    </application>
</manifest>
